# Copy to .env and fill in.  .env is git-ignored.

# The school's IServ domain — without https:// and without /iserv
ISERV_DOMAIN=schule.de
ISERV_USERNAME=vorname.nachname
ISERV_PASSWORD=dein-passwort

# Mail backend: auto (IMAP, fall back to the web interface) | imap | web
ISERV_MAIL_BACKEND=auto
# Only needed if IMAP does not live on the same host as the web interface
ISERV_IMAP_HOST=
ISERV_IMAP_PORT=993

# Only needed if WebDAV is not at https://<domain>/webdav/
# (some schools use https://webdav.<domain>/)
ISERV_WEBDAV_URL=

# Optional tuning
ISERV_TIMEOUT=20
ISERV_RETRIES=3
ISERV_CACHE=true
ISERV_CACHE_TTL=120
